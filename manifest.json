{
  "manifest_version": 3,
  "name": "ChatGPT Local Exporter",
  "version": "0.2.4",
  "description": "Local-only incremental exporter for ChatGPT conversations and Projects.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "chatgpt-local-exporter.user.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ]
}
